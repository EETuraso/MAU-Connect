# Leave both blank for the browser-only demo. Set real values for live accounts.
# Use the legacy anon JWT key from Supabase Project Settings > API Keys.
# Never use a service_role or secret key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Add this in Vercel's project environment settings before the first deployment.
# It enables the exact pnpm version declared in package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
